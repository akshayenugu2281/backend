# ==============================================================================
# Library360 Backend Environment Configuration (.env.example)
# ==============================================================================

# --- 1. Render PostgreSQL Database Configuration ---
# Option A (Recommended on Render): Paste Render's internal or external database URL directly.
# The backend automatically converts postgres:// to jdbc:postgresql:// with SSL!
# DATABASE_URL=postgres://library360_user:password@dpg-xxxxxxxx-a:5432/library360

# Option B: Individual database parameters (or Render fromDatabase variables):
DB_HOST=dpg-xxxxxxxx-a.oregon-postgres.render.com
DB_PORT=5432
DB_NAME=library360
DB_USER=library360_user
DB_PASSWORD=REPLACE_WITH_RENDER_POSTGRES_PASSWORD
DB_SSL_MODE=require

# --- 2. CORS (Frontend URLs - comma separated, no trailing slash) ---
CORS_ORIGINS=https://library360-library360upgraded.vercel.app,http://localhost:5173

# --- 3. Security & Cross-Domain Cookies (Render Production) ---
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# --- 4. JWT & Encryption Secrets ---
# Generate at least 32 random bytes, base64-encoded
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET_AT_LEAST_32_DECODED_BYTES
APP_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY

# --- 5. Initial Seed Accounts (Created on first boot) ---
ADMIN_EMAIL=admin@library360.local
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_MIN_6_CHARS
LIBRARIAN_EMAIL=librarian@library360.local
LIBRARIAN_PASSWORD=REPLACE_WITH_LIBRARIAN_PASSWORD_MIN_6_CHARS

# --- 6. Server & Port ---
# Render sets the PORT environment variable automatically (e.g. 10000 or 8081)
PORT=8081
APP_AI_DEFAULT_MODEL=openai/gpt-4o-mini
